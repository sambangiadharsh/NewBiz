generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Attributes {
  AttributeID                       BigInt                     @id(map: "PK_Attributes") @default(autoincrement())
  AttributeName                     String                     @db.NVarChar(100)
  DataType                          String                     @db.VarChar(20)
  Status                            String                     @db.VarChar(20)
  CreatedAt                         DateTime
  CreatedBy                         BigInt?
  UpdatedAt                         DateTime?
  UpdatedBy                         BigInt?
  Users_Attributes_CreatedByToUsers Users?                     @relation("Attributes_CreatedByToUsers", fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Attributes_CreatedBy_Users_UserID")
  Users_Attributes_UpdatedByToUsers Users?                     @relation("Attributes_UpdatedByToUsers", fields: [UpdatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Attributes_UpdatedBy_Users_UserID")
  AttributeValues                   AttributeValues[]
  CategoryAttributes                CategoryAttributes[]
  ProductVariantAttributes          ProductVariantAttributes[]
}

model Banners {
  BannerID                       BigInt         @id(map: "PK_Banners") @default(autoincrement())
  Title                          String?        @db.NVarChar(255)
  Description                    String?        @db.NVarChar(500)
  ImageURL                       String
  Placement                      String         @db.VarChar(50)
  ProductID                      BigInt?
  CategoryID                     BigInt?
  WarehouseID                    BigInt?
  PromotionID                    BigInt?
  DisplayOrder                   Int
  Status                         String         @db.VarChar(20)
  StartAt                        DateTime?
  EndAt                          DateTime?
  CreatedAt                      DateTime
  CreatedBy                      BigInt?
  UpdatedAt                      DateTime?
  UpdatedBy                      BigInt?
  Categories                     Categories?    @relation(fields: [CategoryID], references: [CategoryID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Banners_CategoryID_Categories_CategoryID")
  Users_Banners_CreatedByToUsers Users?         @relation("Banners_CreatedByToUsers", fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Banners_CreatedBy_Users_UserID")
  ProductMaster                  ProductMaster? @relation(fields: [ProductID], references: [ProductID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Banners_ProductID_ProductMaster_ProductID")
  Promotions                     Promotions?    @relation(fields: [PromotionID], references: [PromotionID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Banners_PromotionID_Promotions_PromotionID")
  Users_Banners_UpdatedByToUsers Users?         @relation("Banners_UpdatedByToUsers", fields: [UpdatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Banners_UpdatedBy_Users_UserID")
  Warehouses                     Warehouses?    @relation(fields: [WarehouseID], references: [WarehouseID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Banners_WarehouseID_Warehouses_WarehouseID")
}

model Brands {
  BrandID                       BigInt          @id(map: "PK_Brands") @default(autoincrement())
  BrandName                     String          @db.NVarChar(150)
  Manufacturer                  String?         @db.NVarChar(150)
  Description                   String?         @db.NVarChar(500)
  Status                        String          @db.VarChar(20)
  ImageURL                      String?         @db.NVarChar(500)
  IsFeatured                    Boolean         @default(false, map: "DF_Brands_IsFeatured")
  DisplayOrder                  Int             @default(0, map: "DF_Brands_DisplayOrder")
  CreatedAt                     DateTime
  CreatedBy                     BigInt?
  UpdatedAt                     DateTime?
  UpdatedBy                     BigInt?
  BrandCode                     String?         @db.VarChar(50)
  Users_Brands_CreatedByToUsers Users?          @relation("Brands_CreatedByToUsers", fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Brands_CreatedBy_Users_UserID")
  Users_Brands_UpdatedByToUsers Users?          @relation("Brands_UpdatedByToUsers", fields: [UpdatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Brands_UpdatedBy_Users_UserID")
  ProductMaster                 ProductMaster[]
}

model CartItems {
  CartItemID      BigInt         @id(map: "PK_CartItems") @default(autoincrement())
  CartID          BigInt
  SellerProductID BigInt
  Quantity        Int
  CreatedAt       DateTime
  UpdatedAt       DateTime?
  Carts           Carts          @relation(fields: [CartID], references: [CartID], onUpdate: NoAction, map: "FK_CartItems_CartID_Carts_CartID")
  SellerProducts  SellerProducts @relation(fields: [SellerProductID], references: [SellerProductID], onUpdate: NoAction, map: "FK_CartItems_SellerProductID_SellerProducts_SellerProductID")
}

model Carts {
  CartID     BigInt      @id(map: "PK_Carts") @default(autoincrement())
  CustomerID BigInt
  Status     String      @db.VarChar(20)
  CreatedAt  DateTime
  UpdatedAt  DateTime?
  CartItems  CartItems[]
  Customers  Customers   @relation(fields: [CustomerID], references: [CustomerID], onUpdate: NoAction, map: "FK_Carts_CustomerID_Customers_CustomerID")
}

model Categories {
  CategoryID                        BigInt               @id(map: "PK_Categories") @default(autoincrement())
  ParentCategoryID                  BigInt?
  CategoryName                      String               @db.NVarChar(150)
  Description                       String?              @db.NVarChar(500)
  IconURL                           String?
  ImageURL                          String?
  BannerURL                         String?
  Status                            String               @db.VarChar(20)
  CreatedAt                         DateTime
  CreatedBy                         BigInt?
  UpdatedAt                         DateTime?
  UpdatedBy                         BigInt?
  CategoryCode                      String?              @db.VarChar(50)
  Banners                           Banners[]
  Users_Categories_CreatedByToUsers Users?               @relation("Categories_CreatedByToUsers", fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Categories_CreatedBy_Users_UserID")
  Categories                        Categories?          @relation("CategoriesToCategories", fields: [ParentCategoryID], references: [CategoryID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Categories_ParentCategoryID_Categories_CategoryID")
  other_Categories                  Categories[]         @relation("CategoriesToCategories")
  Users_Categories_UpdatedByToUsers Users?               @relation("Categories_UpdatedByToUsers", fields: [UpdatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Categories_UpdatedBy_Users_UserID")
  CategoryAttributes                CategoryAttributes[]
  CategoryDocuments                 CategoryDocuments[]
  ProductCategories                 ProductCategories[]
  SellerApplications                SellerApplications[]
}

model CategoryAttributes {
  CategoryAttributeID BigInt     @id(map: "PK_CategoryAttributes") @default(autoincrement())
  CategoryID          BigInt
  AttributeID         BigInt
  IsRequired          Boolean    @default(false, map: "DF__CategoryA__IsReq__7C4F7684")
  DisplayOrder        Int        @default(0, map: "DF__CategoryA__Displ__7D439ABD")
  Status              String     @default("ACTIVE", map: "DF__CategoryA__Statu__7E37BEF6") @db.VarChar(20)
  CreatedAt           DateTime
  CreatedBy           BigInt?
  UpdatedAt           DateTime?
  UpdatedBy           BigInt?
  IsVariantDefining   Boolean    @default(false, map: "DF_CategoryAttributes_IsVariantDefining")
  Attributes          Attributes @relation(fields: [AttributeID], references: [AttributeID], onUpdate: NoAction, map: "FK_CategoryAttributes_AttributeID_Attributes_AttributeID")
  Categories          Categories @relation(fields: [CategoryID], references: [CategoryID], onUpdate: NoAction, map: "FK_CategoryAttributes_CategoryID_Categories_CategoryID")

  @@unique([CategoryID, AttributeID], map: "UX_CategoryAttributes_CategoryID_AttributeID")
}

model CategoryDocuments {
  CategoryDocumentID BigInt        @id(map: "PK_CategoryDocuments") @default(autoincrement())
  CategoryID         BigInt
  DocumentTypeID     Int
  IsMandatory        Boolean       @default(false, map: "DF__CategoryD__IsMan__01142BA1")
  Status             String        @default("ACTIVE", map: "DF__CategoryD__Statu__02084FDA") @db.VarChar(20)
  CreatedAt          DateTime
  CreatedBy          BigInt?
  UpdatedAt          DateTime?
  UpdatedBy          BigInt?
  Categories         Categories    @relation(fields: [CategoryID], references: [CategoryID], onUpdate: NoAction, map: "FK_CategoryDocuments_CategoryID_Categories_CategoryID")
  DocumentTypes      DocumentTypes @relation(fields: [DocumentTypeID], references: [DocumentTypeID], onUpdate: NoAction, map: "FK_CategoryDocuments_DocumentTypeID_DocumentTypes_DocumentTypeID")

  @@unique([CategoryID, DocumentTypeID], map: "UX_CategoryDocuments_CategoryID_DocumentTypeID")
  @@index([CategoryID], map: "IX_CategoryDocuments_CategoryID")
}

model CMSPages {
  PageID                          BigInt    @id(map: "PK_CMSPages") @default(autoincrement())
  PageType                        String    @db.VarChar(50)
  Title                           String    @db.NVarChar(255)
  Slug                            String    @db.VarChar(255)
  Content                         String    @db.NVarChar(Max)
  Status                          String    @db.VarChar(20)
  MetaTitle                       String?   @db.NVarChar(255)
  MetaDescription                 String?   @db.NVarChar(500)
  IsSystemPage                    Boolean?  @default(true, map: "DF__CMSPages__IsSyst__6B24EA82")
  CreatedAt                       DateTime
  CreatedBy                       BigInt?
  UpdatedAt                       DateTime?
  UpdatedBy                       BigInt?
  Users_CMSPages_CreatedByToUsers Users?    @relation("CMSPages_CreatedByToUsers", fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_CMSPages_CreatedBy_Users_UserID")
  Users_CMSPages_UpdatedByToUsers Users?    @relation("CMSPages_UpdatedByToUsers", fields: [UpdatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_CMSPages_UpdatedBy_Users_UserID")
}

model CustomerAddresses {
  CustomerAddressID                                  BigInt    @id(map: "PK_CustomerAddresses") @default(autoincrement())
  CustomerID                                         BigInt
  AddressLabel                                       String    @db.NVarChar(50)
  RecipientName                                      String    @db.NVarChar(200)
  PhoneNumber                                        String?   @db.NVarChar(20)
  AddressLine1                                       String    @db.NVarChar(255)
  AddressLine2                                       String?   @db.NVarChar(255)
  City                                               String    @db.NVarChar(100)
  State                                              String    @db.NVarChar(100)
  PostalCode                                         String    @db.NVarChar(20)
  Country                                            String    @db.NVarChar(100)
  Latitude                                           Decimal?  @db.Decimal(10, 7)
  Longitude                                          Decimal?  @db.Decimal(10, 7)
  IsDefaultShipping                                  Boolean   @default(false, map: "DF__CustomerA__IsDef__3493CFA7")
  IsDefaultBilling                                   Boolean   @default(false, map: "DF__CustomerA__IsDef__3587F3E0")
  CreatedAt                                          DateTime
  UpdatedAt                                          DateTime?
  Customers                                          Customers @relation(fields: [CustomerID], references: [CustomerID], onUpdate: NoAction, map: "FK_CustomerAddresses_CustomerID_Customers_CustomerID")
  Orders_Orders_BillingAddressIDToCustomerAddresses  Orders[]  @relation("Orders_BillingAddressIDToCustomerAddresses")
  Orders_Orders_ShippingAddressIDToCustomerAddresses Orders[]  @relation("Orders_ShippingAddressIDToCustomerAddresses")
}

model CustomerConsents {
  CustomerConsentID BigInt    @id(map: "PK_CustomerConsents") @default(autoincrement())
  CustomerID        BigInt
  ConsentType       String    @db.VarChar(50)
  ConsentVersion    String    @db.VarChar(30)
  IsGranted         Boolean
  GrantedAt         DateTime?
  RevokedAt         DateTime?
  Source            String?   @db.VarChar(30)
  CreatedAt         DateTime
  Customers         Customers @relation(fields: [CustomerID], references: [CustomerID], onUpdate: NoAction, map: "FK_CustomerConsents_CustomerID_Customers_CustomerID")
}

model Customers {
  CustomerID                       BigInt              @id(map: "PK_Customers") @default(autoincrement())
  FirstName                        String              @db.NVarChar(100)
  LastName                         String              @db.NVarChar(100)
  Email                            String?             @db.NVarChar(255)
  PhoneNumber                      String?             @db.NVarChar(20)
  PasswordHash                     String?             @db.NVarChar(500)
  Status                           String              @db.VarChar(20)
  LastLoginAt                      DateTime?
  CreatedAt                        DateTime
  CreatedBy                        BigInt?
  UpdatedAt                        DateTime?
  UpdatedBy                        BigInt?
  Carts                            Carts[]
  CustomerAddresses                CustomerAddresses[]
  CustomerConsents                 CustomerConsents[]
  Users_Customers_CreatedByToUsers Users?              @relation("Customers_CreatedByToUsers", fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Customers_CreatedBy_Users_UserID")
  Users_Customers_UpdatedByToUsers Users?              @relation("Customers_UpdatedByToUsers", fields: [UpdatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Customers_UpdatedBy_Users_UserID")
  Invoices                         Invoices[]
  Orders                           Orders[]
  OTPVerifications                 OTPVerifications[]
  Wishlists                        Wishlists[]
}

model DataAuditLogs {
  AuditLogID    BigInt   @id(map: "PK_DataAuditLogs") @default(autoincrement())
  TableName     String   @db.VarChar(100)
  PrimaryKeyID  BigInt
  ActionType    String   @db.VarChar(20)
  OldData       String?  @db.NVarChar(Max)
  NewData       String?  @db.NVarChar(Max)
  ContextUserID BigInt?
  IPAddress     String?  @db.VarChar(45)
  UserAgent     String?  @db.NVarChar(500)
  CreatedAt     DateTime
}

model DocumentTypes {
  DocumentTypeID                Int                             @id(map: "PK_DocumentTypes") @default(autoincrement())
  Code                          String                          @db.VarChar(50)
  DisplayName                   String                          @db.NVarChar(150)
  Status                        String                          @default("ACTIVE", map: "DF__DocumentT__Statu__5EBF139D") @db.VarChar(20)
  CategoryDocuments             CategoryDocuments[]
  SellerApplicationDocuments    SellerApplicationDocuments[]
  SellerDocumentRequirements    SellerDocumentRequirements?
  SellerWarehouseDocuments      SellerWarehouseDocuments[]
  WarehouseDocumentRequirements WarehouseDocumentRequirements[]
}

model FulfillmentItems {
  FulfillmentItemID  BigInt            @id(map: "PK_FulfillmentItems") @default(autoincrement())
  FulfillmentID      BigInt
  OrderItemID        BigInt
  WarehouseProductID BigInt
  Quantity           Int
  CreatedAt          DateTime
  CreatedBy          BigInt?
  Fulfillments       Fulfillments      @relation(fields: [FulfillmentID], references: [FulfillmentID], onUpdate: NoAction, map: "FK_FulfillmentItems_FulfillmentID_Fulfillments_FulfillmentID")
  OrderItems         OrderItems        @relation(fields: [OrderItemID], references: [OrderItemID], onUpdate: NoAction, map: "FK_FulfillmentItems_OrderItemID_OrderItems_OrderItemID")
  WarehouseProducts  WarehouseProducts @relation(fields: [WarehouseProductID], references: [WarehouseProductID], onUpdate: NoAction, map: "FK_FulfillmentItems_WarehouseProductID_WarehouseProducts_WarehouseProductID")
}

model Fulfillments {
  FulfillmentID    BigInt             @id(map: "PK_Fulfillments") @default(autoincrement())
  OrderID          BigInt
  SellerID         BigInt
  WarehouseID      BigInt
  Status           String             @db.VarChar(30)
  CreatedAt        DateTime
  CreatedBy        BigInt?
  UpdatedAt        DateTime?
  UpdatedBy        BigInt?
  FulfillmentItems FulfillmentItems[]
  Orders           Orders             @relation(fields: [OrderID], references: [OrderID], onUpdate: NoAction, map: "FK_Fulfillments_OrderID_Orders_OrderID")
  Sellers          Sellers            @relation(fields: [SellerID], references: [SellerID], onUpdate: NoAction, map: "FK_Fulfillments_SellerID_Sellers_SellerID")
  Warehouses       Warehouses         @relation(fields: [WarehouseID], references: [WarehouseID], onUpdate: NoAction, map: "FK_Fulfillments_WarehouseID_Warehouses_WarehouseID")
  Invoices         Invoices[]
  Shipments        Shipments[]

  @@index([WarehouseID, Status], map: "IX_Fulfillments_WarehouseID_Status")
}

model Inventory {
  InventoryID           BigInt                  @id(map: "PK_Inventory") @default(autoincrement())
  WarehouseProductID    BigInt
  PhysicalQuantity      Int
  ReservedQuantity      Int
  DamagedQuantity       Int
  SafetyStockQuantity   Int
  UpdatedAt             DateTime
  UpdatedBy             BigInt?
  Users                 Users?                  @relation(fields: [UpdatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Inventory_UpdatedBy_Users_UserID")
  WarehouseProducts     WarehouseProducts       @relation(fields: [WarehouseProductID], references: [WarehouseProductID], onUpdate: NoAction, map: "FK_Inventory_WarehouseProductID_WarehouseProducts_WarehouseProductID")
  InventoryReservations InventoryReservations[]
  InventoryTransactions InventoryTransactions[]
}

model InventoryReservations {
  ReservationID BigInt    @id(map: "PK_InventoryReservations") @default(autoincrement())
  InventoryID   BigInt
  OrderID       BigInt
  Quantity      Int
  Status        String    @db.VarChar(20)
  ExpiresAt     DateTime?
  CreatedAt     DateTime
  UpdatedAt     DateTime?
  Inventory     Inventory @relation(fields: [InventoryID], references: [InventoryID], onUpdate: NoAction, map: "FK_InventoryReservations_InventoryID_Inventory_InventoryID")
  Orders        Orders    @relation(fields: [OrderID], references: [OrderID], onUpdate: NoAction, map: "FK_InventoryReservations_OrderID_Orders_OrderID")

  @@index([OrderID], map: "IX_InventoryReservations_OrderID")
}

model InventoryTransactions {
  InventoryTransactionID BigInt    @id(map: "PK_InventoryTransactions") @default(autoincrement())
  InventoryID            BigInt
  OrderID                BigInt?
  TransactionType        String    @db.VarChar(30)
  Quantity               Int
  Reason                 String?   @db.NVarChar(500)
  PONumber               String?   @db.NVarChar(100)
  POAmount               Decimal?  @db.Decimal(18, 2)
  PODocumentURL          String?
  GRNNumber              String?   @db.NVarChar(100)
  GRNAmount              Decimal?  @db.Decimal(18, 2)
  GRNDocumentURL         String?
  SupplierInvoiceNumber  String?   @db.NVarChar(100)
  InvoiceAmount          Decimal?  @db.Decimal(18, 2)
  InvoiceDocumentURL     String?
  CreatedAt              DateTime
  CreatedBy              BigInt?
  Users                  Users?    @relation(fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_InventoryTransactions_CreatedBy_Users_UserID")
  Inventory              Inventory @relation(fields: [InventoryID], references: [InventoryID], onUpdate: NoAction, map: "FK_InventoryTransactions_InventoryID_Inventory_InventoryID")
  Orders                 Orders?   @relation(fields: [OrderID], references: [OrderID], onDelete: NoAction, onUpdate: NoAction, map: "FK_InventoryTransactions_OrderID_Orders_OrderID")

  @@index([InventoryID, CreatedAt], map: "IX_InventoryTransactions_InventoryID_CreatedAt")
}

model InvoiceItems {
  InvoiceItemID      BigInt     @id(map: "PK_InvoiceItems") @default(autoincrement())
  InvoiceID          BigInt
  OrderItemID        BigInt
  ProductName        String     @db.NVarChar(255)
  Quantity           Int
  MRP                Decimal    @db.Decimal(18, 2)
  TotalMRP           Decimal    @db.Decimal(18, 2)
  UnitPrice          Decimal    @db.Decimal(18, 2)
  DiscountPercentage Decimal    @default(0, map: "DF__InvoiceIt__Disco__6442E2C9") @db.Decimal(5, 2)
  DiscountAmount     Decimal    @default(0, map: "DF__InvoiceIt__Disco__65370702") @db.Decimal(18, 2)
  TaxableAmount      Decimal    @db.Decimal(18, 2)
  CGSTRate           Decimal    @default(0, map: "DF__InvoiceIt__CGSTR__662B2B3B") @db.Decimal(5, 2)
  CGSTAmount         Decimal    @default(0, map: "DF__InvoiceIt__CGSTA__671F4F74") @db.Decimal(18, 2)
  SGSTRate           Decimal    @default(0, map: "DF__InvoiceIt__SGSTR__681373AD") @db.Decimal(5, 2)
  SGSTAmount         Decimal    @default(0, map: "DF__InvoiceIt__SGSTA__690797E6") @db.Decimal(18, 2)
  IGSTRate           Decimal    @default(0, map: "DF__InvoiceIt__IGSTR__69FBBC1F") @db.Decimal(5, 2)
  IGSTAmount         Decimal    @default(0, map: "DF__InvoiceIt__IGSTA__6AEFE058") @db.Decimal(18, 2)
  TaxAmount          Decimal    @default(0, map: "DF__InvoiceIt__TaxAm__6BE40491") @db.Decimal(18, 2)
  TotalAmount        Decimal    @db.Decimal(18, 2)
  CreatedAt          DateTime
  CreatedBy          BigInt?
  Users              Users?     @relation(fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_InvoiceItems_CreatedBy_Users_UserID")
  Invoices           Invoices   @relation(fields: [InvoiceID], references: [InvoiceID], onUpdate: NoAction, map: "FK_InvoiceItems_InvoiceID_Invoices_InvoiceID")
  OrderItems         OrderItems @relation(fields: [OrderItemID], references: [OrderItemID], onUpdate: NoAction, map: "FK_InvoiceItems_OrderItemID_OrderItems_OrderItemID")

  @@unique([InvoiceID, OrderItemID], map: "UX_InvoiceItems_InvoiceID_OrderItemID")
}

model Invoices {
  InvoiceID                       BigInt         @id(map: "PK_Invoices") @default(autoincrement())
  InvoiceNumber                   String         @db.VarChar(50)
  FulfillmentID                   BigInt
  OrderID                         BigInt
  SellerID                        BigInt
  CustomerID                      BigInt
  InvoiceDate                     DateTime
  SubtotalAmount                  Decimal        @db.Decimal(18, 2)
  DiscountAmount                  Decimal        @db.Decimal(18, 2)
  ShippingAmount                  Decimal        @db.Decimal(18, 2)
  CGSTAmount                      Decimal        @default(0, map: "DF__Invoices__CGSTAm__5CA1C101") @db.Decimal(18, 2)
  SGSTAmount                      Decimal        @default(0, map: "DF__Invoices__SGSTAm__5D95E53A") @db.Decimal(18, 2)
  IGSTAmount                      Decimal        @default(0, map: "DF__Invoices__IGSTAm__5E8A0973") @db.Decimal(18, 2)
  TaxAmount                       Decimal        @default(0, map: "DF__Invoices__TaxAmo__5F7E2DAC") @db.Decimal(18, 2)
  TotalAmount                     Decimal        @db.Decimal(18, 2)
  Status                          String         @db.VarChar(20)
  BillingName                     String         @db.NVarChar(200)
  BillingAddressLine1             String         @db.NVarChar(255)
  BillingAddressLine2             String?        @db.NVarChar(255)
  BillingCity                     String         @db.NVarChar(100)
  BillingState                    String         @db.NVarChar(100)
  BillingPostalCode               String         @db.NVarChar(20)
  BillingCountry                  String         @db.NVarChar(100)
  CreatedAt                       DateTime
  CreatedBy                       BigInt?
  UpdatedAt                       DateTime?
  UpdatedBy                       BigInt?
  InvoiceItems                    InvoiceItems[]
  Users_Invoices_CreatedByToUsers Users?         @relation("Invoices_CreatedByToUsers", fields: [CreatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Invoices_CreatedBy_Users_UserID")
  Customers                       Customers      @relation(fields: [CustomerID], references: [CustomerID], onUpdate: NoAction, map: "FK_Invoices_CustomerID_Customers_CustomerID")
  Fulfillments                    Fulfillments   @relation(fields: [FulfillmentID], references: [FulfillmentID], onUpdate: NoAction, map: "FK_Invoices_FulfillmentID_Fulfillments_FulfillmentID")
  Orders                          Orders         @relation(fields: [OrderID], references: [OrderID], onUpdate: NoAction, map: "FK_Invoices_OrderID_Orders_OrderID")
  Sellers                         Sellers        @relation(fields: [SellerID], references: [SellerID], onUpdate: NoAction, map: "FK_Invoices_SellerID_Sellers_SellerID")
  Users_Invoices_UpdatedByToUsers Users?         @relation("Invoices_UpdatedByToUsers", fields: [UpdatedBy], references: [UserID], onDelete: NoAction, onUpdate: NoAction, map: "FK_Invoices_UpdatedBy_Users_UserID")

  @@unique([OrderID, SellerID], map: "UX_Invoices_OrderID_SellerID")
}

model OrderItems {
  OrderItemID        BigInt             @id(map: "PK_OrderItems") @default(autoincrement())
  OrderID            BigInt
  SellerProductID    BigInt
  Quantity           Int
  UnitPrice          Decimal            @db.Decimal(18, 2)
  MRP                Decimal            @db.Decimal(18, 2)
  TotalMRP           Decimal            @db.Decimal(18, 2)
  PurchasePrice      Decimal            @db.Decimal(18, 2)
  TotalPurchasePrice Decimal            @db.Decimal(18, 2)
  DiscountPercentage Decimal            @default(0, map: "DF__OrderItem__Disco__46B27FE2") @db.Decimal(5, 2)
  DiscountAmount     Decimal            @default(0, map: "DF__OrderItem__Disco__47A6A41B") @db.Decimal(18, 2)
  CGSTRate           Decimal            @default(0, map: "DF__OrderItem__CGSTR__489AC854") @db.Decimal(5, 2)
  CGSTAmount         Decimal            @default(0, map: "DF__OrderItem__CGSTA__498EEC8D") @db.Decimal(18, 2)
  SGSTRate           Decimal            @default(0, map: "DF__OrderItem__SGSTR__4A8310C6") @db.Decimal(5, 2)
  SGSTAmount         Decimal            @default(0, map: "DF__OrderItem__SGSTA__4B7734FF") @db.Decimal(18, 2)
  IGSTRate           Decimal            @default(0, map: "DF__OrderItem__IGSTR__4C6B5938") @db.Decimal(5, 2)
  IGSTAmount         Decimal            @default(0, map: "DF__OrderItem__IGSTA__4D5F7D71") @db.Decimal(18, 2)
  TaxAmount          Decimal            @default(0, map: "DF__OrderItem__TaxAm__4E53A1AA") @db.Decimal(18, 2)
  TotalAmount        Decimal            @db.Decimal(18, 2)
  CreatedAt          DateTime
  FulfillmentItems   FulfillmentItems[]
